// DormDash data model.
//
// Authentication lives in Clerk; this database stores the registration profile
// that Clerk does not model: guardians and their students.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Parent {
  id String @id @default(cuid())

  // Clerk's user id is the link between the identity provider and this record.
  clerkUserId String @unique

  // Parent 1 is mandatory and their email is the login id.
  name  String
  email String @unique
  phone String

  // Parent 2 is optional. All three fields are filled together or not at all.
  parent2Name  String?
  parent2Phone String?
  parent2Email String?

  participations EventParticipant[]
  notifications EventNotification[]
  events    Event[]
  students  Student[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Student {
  id       String @id @default(cuid())
  parentId String
  parent   Parent @relation(fields: [parentId], references: [id], onDelete: Cascade)

  name    String
  email   String
  phone   String?
  college String
  dorm    String?
  year    Int?
  major   String

  participations EventParticipant[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A parent cannot register the same student twice.
  @@unique([parentId, email])
  @@index([parentId])
}

enum EventType {
  COLLEGE_PICKUP
  COLLEGE_DROP_OFF
  CARPOOL
  VANPOOL
  BUSPOOL
  PACKAGE_DELIVERY
  ANNOUNCEMENT
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum ParticipationStatus {
  ACCEPTED
  WAITLISTED
}

enum TripService {
  PACKAGE_DELIVERY
  PASSENGER_TRANSPORT
}

model Event {
  id String @id @default(cuid())
  parentId String
  parent Parent @relation(fields: [parentId], references: [id], onDelete: Cascade)

  name String
  color String?
  instructions String?
  origin String?
  destination String?
  college String?
  collegeKey String?
  dorm String?
  major String?
  startsAt DateTime
  allDay Boolean @default(false)
  endsAt DateTime?
  timeZone String @default("America/Los_Angeles")
  dueAt DateTime?
  type EventType
  services TripService[] @default([])
  status EventStatus @default(DRAFT)
  cancellationReason String?
  cancelledAt DateTime?
  paymentRequired Boolean @default(false)
  totalCostCents Int?
  individualCostCents Int?
  maxParticipants Int
  waitingListAllowed Boolean @default(false)
  maxWaitingList Int?

  participants EventParticipant[]
  notifications EventNotification[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([collegeKey, status, startsAt])
  @@index([status, startsAt])
  @@index([parentId, status])
}

model EventNotification {
  id String @id @default(cuid())
  parentId String
  eventId String
  parent Parent @relation(fields: [parentId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  readAt DateTime?

  @@unique([eventId, parentId])
  @@index([parentId, readAt, createdAt])
}

model EventParticipant {
  id String @id @default(cuid())
  eventId String
  parentId String
  studentId String?
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  parent Parent @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  joinedAt DateTime @default(now())
  status ParticipationStatus @default(ACCEPTED)
  requestedServices TripService[] @default([])
  @@unique([eventId, parentId])
  @@index([eventId])
  @@index([parentId])
  @@index([eventId, status, joinedAt, id])
}
