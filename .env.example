# Copy to `.env.local` and fill in real values.
# `.env.local` is gitignored; never commit real secrets.

# --- Clerk (https://dashboard.clerk.com) -----------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Where Clerk sends users after sign-in / sign-up.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database --------------------------------------------------------------
# Neon (or any Postgres) connection string. The same value is used by the app
# and by Prisma migrations. For Neon, prefer the direct (non-pooled) host.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- Optional student college-email verification (server-side only) ----------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=DormDash
# Public app address used in verification links; set separately for each deployment.
APP_URL=http://localhost:3000

# Shared secret for the event email/offer worker; never prefix with NEXT_PUBLIC_.
# Also set as GitHub Actions secret DORMDASH_NOTIFICATION_CRON_SECRET.
CRON_SECRET=
